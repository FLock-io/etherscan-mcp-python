# Etherscan API Configuration
# Get your API key from: https://etherscan.io/apis
ETHERSCAN_API_KEY=your_api_key_here

# MCP Server Configuration (Optional)
# These settings are used when running the server in HTTP mode

# Transport protocol: stdio (default) or http
# MCP_TRANSPORT=stdio

# HTTP server host (only for http transport)
# MCP_HOST=127.0.0.1

# HTTP server port (only for http transport)
# MCP_PORT=8000

# MCP endpoint path (default: /mcp)
# MCP_PATH=/mcp

# Log level: debug, info, warning, error
# MCP_LOG_LEVEL=info